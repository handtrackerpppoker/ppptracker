rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read: tournament list is visible to everyone
    match /tournaments/{id} {
      allow read: if true;
      allow write: if false; // writes via Admin SDK only
    }

    // Public read: shared config (blind structures, payout tables)
    match /config/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user data — only the owner can read/write, EXCEPT the fields the
    // server owns. is_pro/stripe_customer_id gate every Pro feature and are
    // written by the Stripe webhook through the Admin SDK (which bypasses these
    // rules); if the client could write them, any signed-in user could grant
    // themselves Pro from the browser console and skip payment entirely.
    //
    // quota and credits are here for the same reason: they are the free tier's
    // daily import/export counters and its survey unlocks. A counter the browser
    // can zero is not a counter, so both are written only by app.py.
    function serverOnlyFields() {
      return ['is_pro', 'stripe_customer_id', 'subscription_status', 'quota', 'credits'];
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // The app seeds a new user doc with is_pro:false on first visit, so
      // create must permit that exact shape — but not a self-granted true,
      // not a pre-filled quota or credit balance, and not a delete-then-recreate
      // to wash away a cancelled subscription or a spent daily allowance.
      allow create: if request.auth != null && request.auth.uid == uid
                    && (!('is_pro' in request.resource.data)
                        || request.resource.data.is_pro == false)
                    && !request.resource.data.keys()
                          .hasAny(['stripe_customer_id', 'subscription_status', 'quota', 'credits']);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(serverOnlyFields());
      allow delete: if false;
    }

    // Subcollections under a user (leak caches, per-tournament docs) — owner
    // only. Deliberately NOT /users/{uid}/{document=**}: under rules_version 2
    // a recursive wildcard also matches zero segments, i.e. the user doc
    // itself, and because rule matches are OR'd that permissive block would
    // silently re-open the server-owned-field hole closed above.
    //
    // ad_jtis, survey_completions, quota (the tourney_export doc lives at
    // users/{uid}/quota/tourney_export) and gate_events are carved out for the
    // same reason and must be excluded *here* rather than only re-matched
    // below: rule matches are OR'd, so a blanket write on the parent would
    // outvote a stricter rule on the child.
    match /users/{uid}/{sub}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                         && !(sub in ['ad_jtis', 'survey_completions', 'quota', 'gate_events']);
    }

    // Spent export unlocks. The whole point of the jti record is that it exists
    // exactly once, so the account that would benefit from deleting it is the
    // one account that must not be able to.
    match /users/{uid}/ad_jtis/{jti} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Survey payouts, keyed by the provider's own transaction id — this is what
    // makes a redelivered postback pay once. Client-deletable would mean one
    // survey could be cashed in repeatedly.
    match /users/{uid}/survey_completions/{completionId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Tourney-export lifetime-free + weekly counter (a single doc, id
    // 'tourney_export', inside the quota subcollection — distinct from the
    // quota map field on users/{uid} above). A counter the browser can zero
    // is not a counter, same rationale as the daily quota map.
    match /users/{uid}/quota/{quotaDoc} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Gate-event history, shared by tourney-export/hand-export/import gate
    // checks (incl. the "watch to unlock" stub — gate_provider: 'stub').
    // Append-only and server-written; a client-writable log would be
    // worthless for the audit/reporting it exists for, and would let a gate
    // be cashed in repeatedly.
    match /users/{uid}/gate_events/{eventId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Gamification state — owner-readable, never client-writable. This deliberately
    // lives at the top level instead of under /users/{uid}: the update rule above lets
    // the owner write any non-paid field on their own user doc, and the subcollection
    // rule grants blanket write beneath it, so points stored in either place could be
    // edited from the browser console and the leaderboard would mean nothing. Every
    // write here goes through the Admin SDK in gamification.py.
    match /gamification/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Weekly leaderboards — any signed-in player can read the standings (entries carry
    // a display name only, never an email; see gamification.display_name), but scores
    // are written by the Admin SDK alone.
    match /leaderboards/{weekId} {
      allow read:  if request.auth != null;
      allow write: if false;

      match /entries/{uid} {
        allow read:  if request.auth != null;
        allow write: if false;
      }
    }

    // Everything else: deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
